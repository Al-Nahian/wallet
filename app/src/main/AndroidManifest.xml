<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used to show a system notification while the app is backgrounded (plan.md §86);
         the Notification Center itself works without it. Not requested at runtime yet — §59
         says request contextually, and there's no automation feature to justify prompting yet. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WalletApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@style/Theme.Wallet">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WalletApplication supplies its own WorkManager Configuration (Hilt-aware worker
             factory, for RecurringTransactionWorker) via Configuration.Provider, so the default
             auto-initializer — which would otherwise build workers without Hilt injection — is
             removed here, per WorkManager's documented on-demand-initialization pattern. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
