<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used to show a system notification while the app is backgrounded (plan.md §86);
         the Notification Center itself works without it. Not requested at runtime yet — §59
         says request contextually, and there's no automation feature to justify prompting yet. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- plan.md §30/§59 — declared here but only ever requested at runtime from the Automation
         Settings screen, when the user explicitly opts into SMS capture; never on first launch. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".WalletApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Wallet">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- plan.md §30/§59 — registered unconditionally, but inert until the user grants
             RECEIVE_SMS at runtime from Automation Settings; `SmsReceiver` itself also checks the
             capture-enabled setting before doing anything with a message it receives. -->
        <receiver
            android:name=".core.automation.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- WalletApplication supplies its own WorkManager Configuration (Hilt-aware worker
             factory, for RecurringTransactionWorker) via Configuration.Provider, so the default
             auto-initializer — which would otherwise build workers without Hilt injection — is
             removed here, per WorkManager's documented on-demand-initialization pattern. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
