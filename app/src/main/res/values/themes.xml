<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Wallet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- The app draws its own translucent chrome edge to edge; without these the system
             paints a contrast scrim behind the bars, which shows as a stray light strip under
             the floating nav pill. Ignored below API 29. -->
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
